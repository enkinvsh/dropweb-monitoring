# Rendered to prometheus.yml on the panel host by deploy.sh.
# __METRICS_USER__ is substituted from the panel's /opt/remnawave/.env at deploy time;
# the password goes into a separate metrics_pass file. Nothing secret lives in this repo.
global:
  scrape_interval: 30s
  evaluation_interval: 30s
  scrape_timeout: 10s

rule_files:
  - alerts.yml

scrape_configs:
  - job_name: 'remnawave'
    metrics_path: /metrics
    static_configs:
      - targets: ['remnawave:3001']
    basic_auth:
      username: '__METRICS_USER__'
      password_file: /etc/prometheus/metrics_pass

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
