# Grafana admin password (login user is always `admin`). Generate: openssl rand -hex 16
GF_SECURITY_ADMIN_PASSWORD=changeme

# SSH host alias of the Remnawave panel (overridable: ./deploy.sh <host> or make HOST=...)
PANEL_HOST=remnawave-panel

# NOTE: panel metrics credentials (METRICS_USER / METRICS_PASS) are NOT set here.
# deploy.sh reads them from the panel's own /opt/remnawave/.env at deploy time and
# renders prometheus.yml + prometheus/metrics_pass on the host. No secrets in this repo.
